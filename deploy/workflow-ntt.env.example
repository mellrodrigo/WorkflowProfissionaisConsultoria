# Variáveis de ambiente da aplicação.
#
# Instalar em: /etc/workflow-ntt.env
#
#   cp /opt/workflow-ntt/deploy/workflow-ntt.env.example /etc/workflow-ntt.env
#   chown root:workflow /etc/workflow-ntt.env
#   chmod 640 /etc/workflow-ntt.env
#   systemctl restart workflow-ntt
#
# Formato lido pelo systemd (EnvironmentFile): uma linha CHAVE=valor por vez.
# Não use "export", não use aspas desnecessárias e não use expansão de shell
# como ${OUTRA_VAR} — nada disso é interpretado aqui.
#
# Este arquivo é OPCIONAL. Os mesmos valores já vêm como padrão no serviço
# systemd; o arquivo existe para sobrescrevê-los sem editar a unit.


# Ativa o modo de produção. Com este valor:
#   - o cookie de sessão passa a exigir HTTPS (flag Secure);
#   - o CORS é desativado, já que frontend e API ficam na mesma origem.
# Qualquer valor diferente de "production" é tratado como desenvolvimento.
NODE_ENV=production

# Porta em que a aplicação escuta. Precisa ser a mesma do proxy_pass no nginx.
PORT=4000

# Interface de escuta. Mantenha 127.0.0.1: assim a aplicação só é alcançável
# pelo nginx, e a porta acima não fica exposta direto pelo IP do servidor.
# Use 0.0.0.0 apenas se souber exatamente por que precisa disso.
HOST=127.0.0.1

# Controla a flag Secure do cookie de sessão.
# Deixe COMENTADO em produção: sem esta variável, o valor segue o NODE_ENV,
# que é o comportamento correto (cookie Secure sob HTTPS).
#
# Defina como false somente para testar em http:// sem certificado — com
# Secure ligado e sem HTTPS o navegador descarta o cookie e o login não gruda.
# Nunca use false em um servidor exposto à internet.
#SESSION_SECURE=false
